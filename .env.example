SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SMSPOOL_API_KEY=your_smspool_api_key
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_REPLACE_ME
FLUTTERWAVE_WEBHOOK_SECRET_HASH=FLWWHSEC_TEST_REPLACE_ME
FLUTTERWAVE_REDIRECT_URL=http://localhost:5173/#/wallet/success

VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# CPX Research survey wall and postback settings.
CPX_APP_ID=your_cpx_app_id
CPX_SECURE_HASH=your_cpx_secure_hash
CPX_POSTBACK_SECRET=your_random_postback_secret
# Default assumes CPX sends NGN reward units: 1 NGN = 100 kobo.
CPX_REWARD_KOBO_PER_UNIT=100
# Optional fallback when CPX only sends amount_usd and amount_local is missing.
CPX_USD_TO_NGN_RATE=1500
CPX_ENABLE_REVERSALS=false
